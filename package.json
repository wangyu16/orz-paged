{
  "name": "orz-paged",
  "version": "0.7.3",
  "description": "Single-file, self-editing Markdown documents laid out as print-ready pages and exported to PDF from the browser.",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "orz-paged": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "docs/embedding.md",
    "orz-paged-skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle",
    "prebuild": "tsx scripts/sync-version.ts && tsx scripts/sync-templates.ts && tsx scripts/build-themes.ts",
    "bundle": "tsx build/bundle.ts",
    "gen": "tsx src/cli.ts",
    "test": "vitest run",
    "pretest": "tsx scripts/sync-version.ts && tsx scripts/sync-templates.ts && tsx scripts/build-themes.ts",
    "themes": "tsx scripts/build-themes.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "paged",
    "pagedjs",
    "print",
    "pdf",
    "orz-markdown",
    "markdown",
    "self-contained",
    "single-file"
  ],
  "author": "Yu Wang <yuwang@orz.how>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyu16/orz-paged.git"
  },
  "homepage": "https://markdown.orz.how/family.html#paged",
  "bugs": "https://github.com/wangyu16/orz-paged/issues",
  "dependencies": {
    "orz-markdown": "^2.2.0",
    "pagedjs": "0.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=20.16"
  }
}
